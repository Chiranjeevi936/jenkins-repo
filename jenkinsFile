pipeline{
    agent {
        dockerContainer{
        image 'ubuntu:focal'
        }
    }
    stages{
        stage("Build"){
            steps{
                println("Build Step!!")
            }
        }
        stage("Test"){
            steps{
                println("Running Tests!!")
            }
        }
        stage("upload"){
            steps{
                println("Uploading Artifacts!!")
            }
        }
    }
}